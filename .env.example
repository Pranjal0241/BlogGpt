# Copy to .env and fill in exactly one key. Priority order is
# OpenAI, then OpenRouter, then Gemini.

# Option 1 - OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Option 2 - OpenRouter (some free models available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

# Option 3 - Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Review loop tuning.
# Sections scoring below the threshold get rewritten.
REVIEW_THRESHOLD=0.75
# Upper bound on rewrite passes, so runs always terminate.
MAX_REVISIONS=2